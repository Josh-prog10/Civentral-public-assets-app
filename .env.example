# ==========================================
# CIVentral Environment Template (.env.example)
# ==========================================

# PHP system API root. For Expo Go on a phone, use the computer's LAN IP, e.g.
# http://192.168.1.25/civentral-assets/api. Do not use localhost from a phone.
# Leave unset to derive the XAMPP host from Expo's LAN URL (development) or use the hosted system default.
# EXPO_PUBLIC_SYSTEM_API_BASE_URL=http://192.168.1.25/civentral-assets/api

# Optional per-role API overrides; normally derived from EXPO_PUBLIC_SYSTEM_API_BASE_URL.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.25/civentral-assets/api/citizen
# EXPO_PUBLIC_EMPLOYEE_API_BASE_URL=http://192.168.1.25/civentral-assets/api/employee

# Municipal Portal Details
EXPO_PUBLIC_APP_NAME="CIVentral Municipal Portal"
EXPO_PUBLIC_CITY_NAME="Caloocan City"
EXPO_PUBLIC_MUNICIPALITY_CODE="CAL-2026"

# Emergency & Support Hotlines
EXPO_PUBLIC_HOTLINE_NUMBER="(02) 8888-CALOOCAN"
EXPO_PUBLIC_DRRM_HOTLINE="911"

# App Version & Build Configuration
EXPO_PUBLIC_APP_VERSION="v2.4.1"
EXPO_PUBLIC_BUILD_NUMBER="2026.07"
